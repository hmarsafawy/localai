# Hugging Face user access token for gated or private models.
# Create a token at https://huggingface.co/settings/tokens and accept the model license first.
HF_TOKEN=hf_your_access_token_here

# Optional. Raises GitHub's limit for checking llama.cpp releases from 60 to 5000 calls an hour.
# A token with no scopes is enough: https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional. Where runtimes and models are stored. Defaults to the app's own folder.
LOCALAI_DATA_DIR=

# Optional. Where downloaded models go, if not with the rest. Text models go in a text-generation
# folder inside it, and a large one can be 30 GB. Defaults to model-files in the folder above.
LOCALAI_MODELS_DIR=
